# OpenAI-compatible chat-completions endpoint. Use the exact values from your provider.
# Keep the /v1 base path if it is part of the provider's documented endpoint.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL=replace_with_a_tool_calling_model

# Optional: web_search uses Tavily. Wikipedia, arXiv, webpage reading and local time
# tools do not require a Tavily key.
TAVILY_API_KEY=

REQUEST_TIMEOUT=30
MAX_TOOL_ROUNDS=7
